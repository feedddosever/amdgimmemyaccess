# Copy to .env.local for `npm run dev`, or to .env for `docker compose up`.
# Real values never go into Git; on Vercel set them in Project Settings -> Environment Variables.

# OpenAI-compatible endpoint: vLLM on the AMD MI300X droplet, or the AMD Token Factory URL as fallback.
LLM_BASE_URL=http://DROPLET_IP:8000/v1

# The --api-key given to vLLM on the droplet (or your Token Factory key). Secret.
LLM_API_KEY=

# Model name the endpoint serves.
LLM_MODEL=google/gemma-4-26B-A4B-it

# vLLM Prometheus metrics endpoint, read by the AMD panel.
LLM_METRICS_URL=http://DROPLET_IP:8000/metrics

# Droplet price per hour in USD, from the AMD Developer Cloud billing page.
GPU_HOURLY_USD=1.99

# Euros per 1 US dollar, used to show costs in EUR. Check today's rate.
EUR_PER_USD=0.86

# Output tokens per second at concurrency 32, printed by `npm run bench`. Used for cost per call.
BENCH_TOKENS_PER_SEC=

# Passcode for /admin/import. Secret.
ADMIN_PASSCODE=

# 1 = run the whole app with canned answers, no model needed. 0 = call LLM_BASE_URL.
MOCK_LLM=1
